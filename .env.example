# Copy to .env and fill in. Never commit the real .env file.
# opencode.jsonc reads these via the {env:VAR_NAME} substitution syntax;
# the litellm/ and .opencode/mcp/ services read them as normal process env vars.

# --- LiteLLM gateway (used by the "litellm" opencode provider and by the
#     langgraph-agent MCP server for its own LLM calls) ------------------
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-master-change-me     # server-side admin key, litellm/config.yaml
LITELLM_VIRTUAL_KEY=sk-litellm-virtual-opencode     # scoped key you mint for OpenCode, see README
LANGGRAPH_MODEL=claude-sonnet-4-5                   # must match a model_name in litellm/config.yaml

# --- Upstream model providers that LiteLLM fans out to -------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=https://YOUR-RESOURCE.openai.azure.com/
AZURE_API_VERSION=2025-04-01-preview
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- OpenCode Go -----------------------------------------------------------
# Not read from this file -- set via `/connect` in the OpenCode TUI, which
# stores the key in ~/.local/share/opencode/auth.json. Listed here only as
# a reminder that it exists.
# OPENCODE_GO_API_KEY=

# --- Optional: LangGraph Platform / LangSmith Agent Server deployment ----
LANGGRAPH_DEPLOYMENT_URL=
LANGSMITH_API_KEY=

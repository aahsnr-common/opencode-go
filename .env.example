# Copy to .env and fill in. Never commit the real .env file.
#
# NOTE: OpenCode itself needs no variables from this file — provider
# credentials (incl. OpenCode Go) are stored by `/connect` in OpenCode's
# credential table inside ~/.local/share/opencode/opencode.db.
# This file only feeds the OPTIONAL MCP servers and search tools.

# --- langgraph-agent MCP server (graph.py) --------------------------------
# graph.py is a plain OpenAI-compatible client. Defaults point at OpenCode Go;
# pick a model served on /v1/chat/completions per the Go docs endpoint table.
GRAPH_BASE_URL=https://opencode.ai/zen/go/v1
GRAPH_API_KEY=
GRAPH_MODEL=hy3

# --- Optional: LangGraph Platform / LangSmith Agent Server ---------------
LANGGRAPH_DEPLOYMENT_URL=
LANGSMITH_API_KEY=

# --- Optional: v2 websearch providers -------------------------------------
# Connect any one of these via /connect in the TUI, or export its key here.
EXA_API_KEY=
FIRECRAWL_API_KEY=
PARALLEL_API_KEY=
TAVILY_API_KEY=

# --- Optional: extra MCP servers ------------------------------------------
BRAVE_API_KEY=

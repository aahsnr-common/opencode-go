# Local secrets (credentials are supplied via environment variables; only .env.example is tracked)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# uv
# (script dependencies are embedded in PEP 723 blocks; no project lock file expected)

# Test and tooling caches / output
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
report.json

# Logs
*.log

# OS junk
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
coverage/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
